# ============================================================
# NexaHR — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.
# ============================================================

# --- App ---
VITE_APP_NAME="NexaHR Enterprise HRIS"
VITE_APP_VERSION="1.0.0"

# --- API Base URL (for backend/MySQL integration) ---
# Leave empty to use the built-in mock/demo data mode.
# Set to your backend URL when using the MySQL backend (see /backend folder).
VITE_API_BASE_URL=

# --- Auth Secret (optional, for JWT signing on backend) ---
# Only needed if you run the Express backend server.
# JWT_SECRET=your_super_secret_key_here
